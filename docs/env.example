# ---------- LLM: OpenCode Zen (verify current docs before use) ----------
ZEN_API_KEY=
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_MODEL=big-pickle

# Embeddings: "local" or "provider". Local needs no key.
EMBEDDINGS_BACKEND=local
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5

# ---------- Sources (required: at least one search source) ----------
TAVILY_API_KEY=

# Optional connectors: leave blank to disable cleanly
GITHUB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=
X_BEARER_TOKEN=

# ---------- Budgets (balanced profile defaults) ----------
DEFAULT_PROFILE=balanced
MAX_RESEARCH_ROUNDS=3
MAX_CONCURRENT_TUNNELS=5
MAX_TASK_RETRIES=1
MAX_LLM_CALLS_PER_RUN=25
MAX_RUN_SECONDS=120
MAX_REPORT_REPAIRS=1

# ---------- HTTP fetch safety ----------
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_BODY_BYTES=2097152

# ---------- Project indexing ----------
PROJECT_MAX_FILES=2000
PROJECT_MAX_FILE_BYTES=262144
PROJECT_MAX_TOTAL_BYTES=20971520

# ---------- Freshness thresholds (months) ----------
FRESH_GITHUB_MONTHS=6
STALE_GITHUB_MONTHS=18
FRESH_WEB_MONTHS=12
STALE_WEB_MONTHS=24
FRESH_COMMUNITY_MONTHS=3
STALE_COMMUNITY_MONTHS=12

# ---------- Database ----------
DATABASE_URL=sqlite:///./raven.db
CHECKPOINT_DB_PATH=./raven_checkpoints.db
# Later: postgresql+psycopg://user:pass@localhost:5432/raven

# ---------- API / server ----------
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Observability (optional) ----------
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=raven
