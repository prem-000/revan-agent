# ── Required ──────────────────────────────────────────────────────
# Tavily API key for web search (get one at https://tavily.com)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ── Local LLM (Ollama) ────────────────────────────────────────────
# Uncomment and configure to use local models
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── LLM Provider Routing & Fallback ────────────────────────────────
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=opencode
LLM_FALLBACK_ENABLED=true
LLM_MAX_RETRIES=2

# ── Primary LLM Provider: Groq (with 1-5 key failover chaining) ──────
LLM_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Supported alternatives: openai/gpt-oss-20b, qwen/qwen3.8-27b, llama-3.3-70b-versatile

# Primary Groq API Key (or use GROQ_API_KEY_1..5 for priority failover pool)
GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_API_KEY_1=gsk_your_key_1
# GROQ_API_KEY_2=gsk_your_key_2
# GROQ_API_KEY_3=gsk_your_key_3
# GROQ_API_KEY_4=gsk_your_key_4
# GROQ_API_KEY_5=gsk_your_key_5

# ── Automatic Fallback Provider: OpenCode Zen (Big Pickle) ───────────
OPENCODE_API_KEY=oc_sk_your_opencode_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=big-pickle

# ── Shared Run Budgets ──────────────────────────────────────────────
MAX_LLM_CALLS_PER_RUN=30
MAX_RUN_TIME_SECONDS=300

# ── Source Connectors (Optional) ────────────────────────────────────
# GitHub Personal Access Token for GitHub source tunnel
GITHUB_TOKEN=ghp_your_github_token_here

# ── Alternative Cloud / Local LLM Providers ────────────────────────
# TOGETHER_API_KEY=your-key-here
# TOGETHER_MODEL=mistralai/Mixtral-8x22B-Instruct-v0.1

# DeepSeek
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-chat

# Mistral
# MISTRAL_API_KEY=your-key-here
# MISTRAL_MODEL=mistral-large-latest

# ── Search Configuration ──────────────────────────────────────────
# Topic focus for Tavily search (default: general)
# TAVILY_TOPIC=general

# Max search results per query (default: 10)
# MAX_SEARCH_RESULTS=10

# Max context characters for LLM input (default: 12000)
# MAX_CONTEXT_CHARS=12000

# ── LLM Settings ──────────────────────────────────────────────────
# Seed for deterministic generation (default: 42)
# DEFAULT_SEED=42

# Temperature for LLM sampling (default: 0.2)
# DEFAULT_TEMPERATURE=0.2

# Top-p for nucleus sampling (default: 0.9)
# DEFAULT_TOP_P=0.9

# ── Application ───────────────────────────────────────────────────
# Log level (default: INFO)
# LOG_LEVEL=INFO

# Frontend origin for CORS (default: http://localhost:5173)
# FRONTEND_ORIGIN=http://localhost:5173

# ── LangSmith Tracing (optional) ──────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2-your-key-here
# LANGSMITH_PROJECT=auto-researcher

# ── Feature Flags & Advanced Upgrade Modes ────────────────────────
RELEVANCE_FILTER=true
ANSWER_FIRST=true
SELF_CHECK=true
GRAPH_EVENT=true
MAX_SELF_CHECK_ROUNDS=2
GENERATE_FULL_REPORT_UPFRONT=true
